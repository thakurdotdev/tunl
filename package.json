{
  "name": "tunl",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "lint": "oxlint control-plane dashboard",
    "lint:fix": "oxlint --fix control-plane dashboard",
    "format": "oxfmt --write control-plane dashboard",
    "format:check": "oxfmt --check control-plane dashboard",
    "go:format": "find tunnel-server -type f -name '*.go' -print0 | xargs -0 gofmt -w",
    "go:format:check": "test -z \"$(find tunnel-server -type f -name '*.go' -print0 | xargs -0 gofmt -l)\"",
    "go:check": "cd tunnel-server && go vet ./... && go test -race ./...",
    "check": "pnpm run format:check && pnpm run lint && pnpm run go:format:check && pnpm run go:check"
  },
  "devDependencies": {
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0"
  }
}